# QuadRF LoRa PHY startup (systemd EnvironmentFile for quadrf-lora-phy.service).
# Edit and: sudo systemctl restart quadrf-lora-phy quadrf-meshtasticd
# The appliance GUI frequency sliders retune the channel live (PHY follows them
# and keeps the RX IF offset). GUI gain and Ch: masks still override until restart.

# --ota = RF over the air. --digital = FPGA loopback (no RF).
QUADRF_LORA_PHY_MODE=--ota
QUADRF_LORA_PHY_SOCKET=/run/quadrf/phy.sock

# Startup preset until meshtasticd sends lora.modem_preset: shortturbo (500 kHz
# SF7), shortfast, shortslow, mediumfast, mediumslow, longfast, longmoderate,
# longslow, verylongslow (62.5 kHz SF12), longturbo.
QUADRF_LORA_PHY_PRESET=shortturbo

# Center MHz. Meshtastic lora.override_frequency does not set this.
QUADRF_LORA_PHY_FREQ=5800

QUADRF_LORA_PHY_TX_GAIN=25
QUADRF_LORA_PHY_RX_GAIN=45
QUADRF_LORA_PHY_AMPLITUDE=0.7

# Bitmask: 1=ant1, 2=ant2, 4=ant3, 8=ant4, 15=all. Single antenna avoids
# multi-path self-cancellation. PHY also programs interleave=0, autosteer=0.
QUADRF_LORA_PHY_TX_ANT=1
QUADRF_LORA_PHY_RX_ANT=1

# Low-IF receive. RX LO sits at FREQ - IF; the host stream runs at RX_RATE and
# a DDC (NCO + 2-stage FIR, NEON) shifts the channel back to 0 Hz and
# decimates to twice the preset bandwidth (1 Msps at Short Turbo). Moves the chirps off the zero-IF DC servo notch and
# replaces the driver's unfiltered Farrow decimation: SF7/500k 10% PER goes
# from -2.6 to -6.4 dB S/(N0*BW). Costs ~0.35 A76 core. RX_IF_KHZ=0 with
# RX_RATE=1e6 is the old zero-IF path.
QUADRF_LORA_PHY_RX_RATE=8e6
QUADRF_LORA_PHY_RX_IF_KHZ=500

# Poll the synths once a second while idle; when the GUI (or quadrf-jtag)
# moves the TX or RX LO, that frequency becomes the channel: TX LO = channel,
# RX LO = channel - IF. Set 0 to leave GUI LO writes alone.
QUADRF_LORA_PHY_LO_FOLLOW=1

# Baseband filter MHz
QUADRF_LORA_PHY_RX_BW=4
QUADRF_LORA_PHY_TX_BW=20

# Extra wall time (ms) after the first silent TX write before PA mute. PHY also
# reads this from the environment; 0 is the packaged default.
QUADRF_LORA_PHY_PA_DRAIN_MS=0
