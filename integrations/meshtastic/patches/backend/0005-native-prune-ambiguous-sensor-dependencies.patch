Description: Prune unused native sensor inputs with incomplete license grants
 The headless QuadRF service does not expose Portduino environmental-sensor
 telemetry, I2C motion sensing, or INA/MAX17048 power telemetry. Exclude those
 features and the unused environmental dependency group. Make the optional
 seesaw rotary backend compile only when its header is available, so the
 unresolved seesaw package and its display dependency are not build inputs.
Forwarded: not-needed
Last-Update: 2026-08-20
--- a/variants/native/portduino.ini
+++ b/variants/native/portduino.ini
@@ -19,7 +19,6 @@ lib_deps =
   ${env.lib_deps}
   ${networking_base.lib_deps}
   ${networking_extra.lib_deps}
   ${radiolib_base.lib_deps}
-  ${environmental_base.lib_deps}
   # renovate: datasource=custom.pio depName=rweather/Crypto packageName=rweather/library/Crypto
   rweather/Crypto@0.4.0
@@ -29,11 +28,7 @@ lib_deps =
