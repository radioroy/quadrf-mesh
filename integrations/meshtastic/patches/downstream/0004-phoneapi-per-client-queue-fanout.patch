+void MeshService::registerPhoneClient(PhoneAPI *client)
+{
+    concurrency::LockGuard guard(&phoneClientsLock);
+    for (PhoneAPI *c : phoneClients) {
+        if (c == client) return;
+    }
+    phoneClients.push_back(client);
+    LOG_INFO("registerPhoneClient: total active clients=%zu", phoneClients.size());
+}
+
+void MeshService::unregisterPhoneClient(PhoneAPI *client)
+{
+    concurrency::LockGuard guard(&phoneClientsLock);
+    for (auto it = phoneClients.begin(); it != phoneClients.end(); ++it) {
+        if (*it == client) {
+            phoneClients.erase(it);
+            LOG_INFO("unregisterPhoneClient: remaining active clients=%zu", phoneClients.size());
+            return;
+        }
+    }
+}
