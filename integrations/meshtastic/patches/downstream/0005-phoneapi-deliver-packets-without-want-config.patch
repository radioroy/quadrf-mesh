@@ -907,13 +920,26 @@ void PhoneAPI::enqueueClientPacket(meshtastic_MeshPacket *p)
     concurrency::LockGuard guard(&clientQueueLock);
     constexpr size_t kMaxClientQueue = 32;
     if (clientPacketQueue.size() >= kMaxClientQueue) {
-        meshtastic_MeshPacket *oldest = clientPacketQueue.front();
-        clientPacketQueue.pop_front();
-        if (oldest && service) {
-            service->releaseToPool(oldest);
+        meshtastic_MeshPacket *victim = nullptr;
+        for (auto it = clientPacketQueue.begin(); it != clientPacketQueue.end(); ++it) {
+            if (*it && (*it)->which_payload_variant == meshtastic_MeshPacket_decoded_tag &&
+                (*it)->decoded.portnum != meshtastic_PortNum_TEXT_MESSAGE_APP &&
+                (*it)->decoded.portnum != meshtastic_PortNum_RANGE_TEST_APP) {
+                victim = *it;
+                clientPacketQueue.erase(it);
+                break;
+            }
         }
-        LOG_WARN("Client packet queue full, dropped oldest packet");
+        if (!victim) {
+            victim = clientPacketQueue.front();
+            clientPacketQueue.pop_front();
+        }
+        if (victim && service) {
+            service->releaseToPool(victim);
+        }
+        LOG_WARN("Client packet queue full, dropped a packet");
     }
