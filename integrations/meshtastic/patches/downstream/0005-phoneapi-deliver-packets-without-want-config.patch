@@ -113,7 +113,9 @@ class PhoneAPI : public Observer<uint32_t>, public concurrency::OSThread
     virtual void close();
 
-    bool isInterestedInPackets() const { return state != STATE_SEND_NOTHING; }
+    bool isInterestedInPackets() const {
+        return state == STATE_SEND_PACKETS || (api_type == TYPE_HTTP && state == STATE_SEND_NOTHING);
+    }
     void enqueueClientPacket(meshtastic_MeshPacket *p);
     meshtastic_MeshPacket *getClientPacket();
 
